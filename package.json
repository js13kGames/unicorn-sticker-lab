{
  "name": "unicorn-sticker-lab",
  "displayName": "Unicorn Sticker Lab",
  "version": "1.0.0",
  "scripts": {
    "start": "pnpm run dev",
    "dev": "node esbuild.js",
    "test": "jest --color",
    "prod": "pnpm run build-prod && pnpm run eslint && pnpm run preview-prod",
    "prod:skip-lint": "pnpm run build-prod && pnpm run preview-prod",
    "pack": "cd build && bestzip --level 9 build.zip *",
    "size": "node ./check-size.js",
    "eslint": "eslint src/**/*.ts",
    "build-prod": "rm -rf build/* && node ./esbuild-prod.js && node ./roadroll.js && npm run pack && npm run size",
    "preview-prod": "cd build && http-server -p 3030"
  },
  "devDependencies": {
    "@craftamap/esbuild-plugin-html": "^0.6.1",
    "@types/jest": "^29.5.2",
    "@typescript-eslint/eslint-plugin": "^2.34.0",
    "@typescript-eslint/parser": "^2.34.0",
    "babel-eslint": "^10.1.0",
    "bestzip": "^2.2.1",
    "esbuild": "0.19.1",
    "esbuild-postcss": "^0.0.4",
    "eslint": "^5.16.0",
    "eslint-config-airbnb-base": "^13.2.0",
    "eslint-import-resolver-webpack": "^0.11.1",
    "eslint-plugin-import": "^2.32.0",
    "http-server": "^14.1.1",
    "jest": "^29.6.0",
    "jest-environment-jsdom": "^29.6.0",
    "postcss": "^8.5.6",
    "postcss-simple-vars": "^7.0.1",
    "roadroller": "^2.1.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "webpack@>=5.0.0-alpha.0 <5.94.0": ">=5.94.0",
      "esbuild@<=0.24.2": ">=0.25.0",
      "tmp@<=0.2.3": ">=0.2.4"
    }
  }
}
